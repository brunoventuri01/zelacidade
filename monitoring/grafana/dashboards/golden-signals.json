{"title":"ZelaCidade - Quatro Métricas de Ouro","uid":"zelacidade-golden-signals","schemaVersion":39,"version":1,"refresh":"15s","time":{"from":"now-1h","to":"now"},"panels":[{"id":1,"title":"Latência p95","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"zelacidade-api\"}[5m])))","legendFormat":"p95"}],"fieldConfig":{"defaults":{"unit":"s"}}},{"id":2,"title":"Tráfego (req/s)","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum(rate(http_requests_total{job=\"zelacidade-api\"}[5m]))","legendFormat":"requisições/s"}]},{"id":3,"title":"Erros HTTP 5xx","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"sum(rate(http_requests_total{job=\"zelacidade-api\",status=~\"5..\"}[5m]))","legendFormat":"erros/s"}]},{"id":4,"title":"Saturação de CPU","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)","legendFormat":"CPU usada"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},{"id":5,"title":"Memória utilizada","type":"gauge","gridPos":{"h":7,"w":8,"x":0,"y":16},"targets":[{"expr":"100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)","legendFormat":"RAM"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},{"id":6,"title":"Disponibilidade da API","type":"stat","gridPos":{"h":7,"w":8,"x":8,"y":16},"targets":[{"expr":"up{job=\"zelacidade-api\"}","legendFormat":"API"}]}]}
