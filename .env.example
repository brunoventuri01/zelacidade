# Copie para .env e troque os CHANGE_ME por valores locais. Nunca versione o .env.
# Valores CHANGE_ME são tratados como vazios: a integração correspondente fica desligada (HTTP 503).

# Banco local do docker compose
POSTGRES_DB=zelacidade
POSTGRES_USER=zelacidade
POSTGRES_PASSWORD=CHANGE_ME

# Fora do compose (ex.: Azure), a aplicação lê a string completa.
# No Azure ela fica só nos App Settings (Neon), nunca aqui.
DATABASE_URL=

# Uma credencial por cliente de integração (gere valores aleatórios e diferentes)
ROBOT_API_KEY=CHANGE_ME
RPA_API_KEY=CHANGE_ME
EXPORT_API_KEY=CHANGE_ME
ADMIN_TOKEN=CHANGE_ME
HASH_SALT=CHANGE_ME

# Assistente (API do Guilherme). Vazio = modo offline com trechos oficiais.
# Na CPU a resposta leva ~35 s (a 1ª chamada ~2x): mantenha 60 s.
GENAI_API_URL=
GENAI_API_KEY=
GENAI_TIMEOUT=60

# Visão computacional (best.onnx em backend/models/visao/)
CV_CONF_LIMIAR=0.35

# Monitoramento local opcional
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
